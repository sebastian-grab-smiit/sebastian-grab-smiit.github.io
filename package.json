{
  "name": "cv-sebastian-grab",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run images",
    "build": "next build",
    "start": "node scripts/serve-static.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:sheet": "node --env-file-if-exists=.env --import tsx scripts/check-sheet.ts",
    "images": "node --env-file-if-exists=.env --import tsx scripts/fetch-images.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "jszip": "^3.10.1",
    "lenis": "^1.3.17",
    "lucide-react": "^0.454.0",
    "next": "^16.4.2",
    "papaparse": "^5.4.1",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.9",
    "react-country-flag": "^3.1.0",
    "react-dom": "^19.2.9",
    "tailwind-merge": "^2.5.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.9",
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.1.9",
    "tsx": "^4.23.15",
    "tw-animate-css": "1.3.3",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "commit-msg": "npx --no -- commitlint --edit \"$1\""
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": "prettier --write"
  }
}
